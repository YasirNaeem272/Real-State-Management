@model RSM.BOL.Models.PropertySell
@*https://localhost:44316/PropertySell/ConfirmSale*@

<div class="col-md-6 col-xs-12">
    <div class="x_panel">
        <div class="x_title">
            <h2>Confirm Property Sell <small>different form elements</small></h2>
            <div class="clearfix"></div>
        </div>

        <div class="x_content">
            <br />
            @using (Html.BeginForm("ConfirmSale", "PropertySell", FormMethod.Post,
                new { @class = "form-horizontal form-label-left", @id = "myForm", @enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()


                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @*---PropertyID---*@

                //---TotalCostOfProperty---
                <div class="form-group">
                    @Html.LabelFor(model => model.TotalCostOfProperty, htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.TotalCostOfProperty, new { htmlAttributes = new { @class = "form-control", placeholder = "Total cose of property" } })
                        @Html.ValidationMessageFor(model => model.TotalCostOfProperty, "", new { @class = "text-danger" })
                    </div>
                </div>

                @*---PaymentOnBooking---*@
                <div class="form-group">
                    @Html.LabelFor(model => model.PaymentOnBooking, new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.PaymentOnBooking, new { htmlAttributes = new { @class = "form-control", placeholder = "On booking" } })
                        @Html.ValidationMessageFor(model => model.PaymentOnBooking, "", new { @class = "text-danger" })

                    </div>
                </div>


                @*---PossessionCharges---*@
                <div class="form-group">
                    @Html.LabelFor(model => model.PossessionCharges, new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.PossessionCharges, new { htmlAttributes = new { @Id = "projName", @class = "form-control", placeholder = "Possession charges" } })
                        @Html.ValidationMessageFor(model => model.PossessionCharges, "", new { @class = "text-danger" })
                    </div>
                </div>

                //---CornerCharges---
                <div class="form-group">
                    @Html.LabelFor(model => model.CornerCharges, new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.CornerCharges, new { htmlAttributes = new { @class = "form-control", placeholder = "Corner charges" } })
                        @Html.ValidationMessageFor(model => model.CornerCharges, "", new { @class = "text-danger" })

                    </div>
                </div>

                //---DevelopmentCharges---
                <div class="form-group">
                    @Html.LabelFor(model => model.DevelopmentCharges, new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.DevelopmentCharges, new { htmlAttributes = new { @class = "form-control", placeholder = "Development charges" } })
                        @Html.ValidationMessageFor(model => model.DevelopmentCharges, "", new { @class = "text-danger" })

                    </div>
                </div>

                //---Balance---
                <div class="form-group">
                    @Html.LabelFor(model => model.Balance, htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.Balance, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                        @Html.ValidationMessageFor(model => model.Balance, "", new { @class = "text-danger" })
                    </div>
                </div>

                //---SoldDate---
                <div class="form-group">
                    @Html.LabelFor(model => model.SoldDate, new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.SoldDate, new { htmlAttributes = new { @class = "form-control", placeholder = "Date" } })
                        @Html.ValidationMessageFor(model => model.SoldDate, "", new { @class = "text-danger" })

                    </div>
                </div>

                //---PossessionDate---
                <div class="form-group">
                    @Html.LabelFor(model => model.PossessionDate, new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.PossessionDate, new { htmlAttributes = new { @class = "form-control", placeholder = "PossessionDate" } })
                        @Html.ValidationMessageFor(model => model.PossessionDate, "", new { @class = "text-danger" })

                    </div>
                </div>

                <!-- Payment Plan -->
                <div class="form-group">
                    @Html.LabelFor(model => model.PaymentPlan, htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EnumDropDownListFor(model => model.PaymentPlan, "Choose", htmlAttributes: new { @class = "form-control", @id = "paymentPlan" })
                        @Html.ValidationMessageFor(model => model.PaymentPlan, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Number of Installments -->
                <div class="form-group" id="installments-group" style="display: none;">
                    @Html.LabelFor(model => model.NumberOfInstallments, htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EditorFor(model => model.NumberOfInstallments, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.NumberOfInstallments, "", new { @class = "text-danger" })
                    </div>
                </div>

                //---PaymentType---
                <div class="form-group">
                    @Html.LabelFor(model => model.PaymentType, htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @Html.EnumDropDownListFor(model => model.PaymentType, "Choose Payment Type", htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.PaymentType, "", new { @class = "text-danger" })
                    </div>
                </div>

                //---CareOf---
                <div class="form-group">
                    @Html.LabelFor(model => model.CareOf, htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                    <div class="col-md-9 col-sm-9 col-xs-12">
                        @*@Html.EditorFor(model => model.CareOf, new { htmlAttributes = new { @class = "form-control" } })*@
                        @Html.DropDownListFor(m => m.CareOf, (SelectList)ViewBag.CareOfOptions, "Select a User", new { @class = "form-control" })

                        @Html.ValidationMessageFor(model => model.CareOf, "", new { @class = "text-danger" })
                    </div>
                </div>

                <br>
                <br>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Confirm Sale" class="btn btn-success btn-round" />
                    </div>
                </div>


            }


        </div>
    </div>
</div>

<!-- JavaScript to handle show/hide -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const paymentPlanDropdown = document.getElementById("paymentPlan");
        const installmentsGroup = document.getElementById("installments-group");

        // Function to toggle display based on selected payment plan
        function toggleInstallments() {
            if (paymentPlanDropdown.value === "1") {
                installmentsGroup.style.display = "block";
            } else {
                installmentsGroup.style.display = "none";
            }
        }

        // Initial check on page load
        toggleInstallments();

        // Check on dropdown change
        paymentPlanDropdown.addEventListener("change", toggleInstallments);
    });</script>
