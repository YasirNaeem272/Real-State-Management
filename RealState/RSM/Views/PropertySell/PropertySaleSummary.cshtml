@model Tuple<RSM.BOL.Models.Owner, RSM.BOL.Models.Property, RSM.BOL.Models.Nominee, RSM.BOL.Models.PropertySell>
@{
    ViewBag.Title = "PropertySaleSummary";
}

@{
    var owner = Model.Item1;
    var property = Model.Item2;
    var nominee = Model.Item3;
    var saleData = Model.Item4;

 }

<<div class="summary-container">
    <h2>Property Sale Summary</h2>

    <!-- Property Details Section -->
    <div class="section">
        <h3>Property Details</h3>
        <div class="info">
            <strong>Location:</strong> <span>@property.ProjectName</span>
        </div>
        <div class="info">
            <strong>Plot No:</strong> <span>@property.PlotNo</span>
        </div>
        <div class="info">
            <strong>Block:</strong> <span>@property.Block</span>
        </div>
        <div class="info">
            <strong>Size:</strong> <span>@property.Size</span>
        </div>
        <div class="info">
            <strong>Property Type:</strong> <span>@property.PropertyType</span>
        </div>

        @*Edit and Details Button*@
        <div class="section-buttons">
            <button class="btn primary-btn">
                <i class="fa fa-info-circle"> </i> &nbsp;&nbsp;Details
            </button>
            @*<button class="btn primary-btn">
                    <i class="fa fa-edit"> </i> &nbsp;&nbsp;Edit
                </button>*@
        </div>
    </div>

    <!-- Owner Details Section -->
    <div class="section">
        <h3>Owner Details</h3>
        <div class="right col-xs-4 col-md-2 col-sm-2 text-center">
            <img src="@Url.Content(owner.ImagePath)" alt="" class="img-circle img-responsive">
        </div>
        <div class="info">
            <strong>Name:</strong> <span>@owner.FirstName @owner.LastName</span>
        </div>
        <div class="info">
            <strong>CNIC:</strong> <span>@owner.CNIC</span>
        </div>
        <div class="info">
            <strong>Phone Number:</strong> <span>@owner.CellNo</span>
        </div>
        <div class="info">
            <strong>Owner Type:</strong> <span>@owner.OwnerType</span>
        </div>
        @*Edit and Details Button*@
        <div class="section-buttons">
            <button class="btn primary-btn">
                <i class="fa fa-info-circle"> </i> &nbsp;&nbsp;Details
            </button>
            @*<button class="btn primary-btn">
                    <i class="fa fa-edit"> </i> &nbsp;Change
                </button>*@
        </div>
    </div>

    <!-- Nominee Details Section -->
    <div class="section">
        <h3>Nominee Details</h3>
        <div class="right col-xs-4 col-md-2 col-sm-2 text-center">
            <img src="@Url.Content(nominee.ImagePath)" alt="" class="img-circle img-responsive">
        </div>
        <div class="info">
            <strong>Name:</strong> <span>@nominee.Name</span>
        </div>
        <div class="info">
            <strong>CNIC:</strong> <span>@nominee.CNIC</span>
        </div>
        <div class="info">
            <strong>Phone Number:</strong> <span>@nominee.CellNo</span>
        </div>
        <div class="info">
            <strong>Relation with owner:</strong> <span>@nominee.Relation</span>
        </div>
        @*Edit and Details Button*@
        <div class="section-buttons">
            <button class="btn primary-btn">
                <i class="fa fa-info-circle"> </i> &nbsp;&nbsp;Details
            </button>
            @*<button class="btn primary-btn">
                    <i class="fa fa-edit"> </i> &nbsp;&nbsp;Edit
                </button>*@
        </div>
    </div>

    <!-- Property Sale Section -->

    <div class="section">
        <h3>Sale Details</h3>
        <div class="info">
            <strong>Cost Of Property:</strong> <span>@saleData.TotalCostOfProperty</span>
        </div>
        <div class="info">
            <strong>On Booking:</strong> <span>@saleData.PaymentOnBooking</span>
        </div>

        <div class="info">
            <strong>Balance:</strong> <span>@saleData.Balance</span>
        </div>
        @*---Other Charges---*@
        <br>
        <h3>Other Charges</h3>
        <div class="info">
            <strong>Possession Charges:</strong> <span>@saleData.PossessionCharges</span>
        </div>

        <div class="info">
            <strong>Corner Charges:</strong> <span>@saleData.CornerCharges</span>
        </div>
        <div class="info">
            <strong>Development Charges:</strong> <span>@saleData.DevelopmentCharges</span>
        </div>
        @*---Dates---*@
        <br>
        <h3>Dates</h3>
        <div class="info">
            <strong>Sold Date:</strong> <span>@saleData.SoldDate</span>
        </div>

        <div class="info">
            <strong>Possession Date:</strong> <span>@saleData.PossessionDate</span>
        </div>

        @*---Payment Plan---*@
        <br>
        <h3>Payment Plan</h3>
        <div class="info">
            <strong>Payment Plan:</strong> <span>@saleData.PaymentPlan</span>
        </div>

        @{
            if (saleData.PaymentPlan.ToString() == PaymentPlan.Installlement.ToString())
            {
                <div class="info">
                    <strong>Installments (months):</strong> <span>@saleData.NumberOfInstallments</span>
                </div>

                <div class="info">
                    <strong>Per-Month:</strong> <span>@saleData.PerMonthInstallment</span>
                </div>
            }
        }

        @*---Payment Receiving---*@
        <br>
        <h3>Payment Receiving</h3>
        <div class="info">
            <strong>Payment Type:</strong> <span>@saleData.PaymentType</span>
        </div>

        <div class="info">
            <strong>Care of:</strong> <span>@saleData.CareOf</span>
        </div>

        <div class="section-buttons">
            <button class="btn primary-btn">
                <i class="fa fa-edit"> </i> &nbsp;&nbsp;Edit
            </button>
        </div>

    </div>

    
    <div class="main-buttons">
        <button class="btn-main primary-btn col-md-10">Back to Properties</button>
        <button class="btn-main btn-success">
            <i class="fa fa-print"> </i> &nbsp;&nbsp;Print File
        </button>
    </div>
    </div>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            color: #3d5b7a; /* Updated text color */
        }

        .summary-container {
            max-width: 800px;
            margin: auto;
            padding: 20px;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h2 {
            text-align: center;
            color: #3d5b7a; /* Updated text color */
            margin-bottom: 30px;
            font-size: 1.8em;
            font-weight: 600;
        }

        /* Section styling */
        .section {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 6px;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            position: relative;
        }

       
            .section h3 {
                margin-top: 0;
                color: #3d5b7a; /* Updated text color */
                border-bottom: 1px solid #ddd;
                padding-bottom: 5px;
                margin-bottom: 15px;
                font-size: 1.2em;
                font-weight: 500;
            }

        /* Label-value pairs styling */
        .info {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 0.95em;
        }

            .info strong {
                color: #3d5b7a; /* Updated text color */
                font-weight: 600;
            }

            .info span {
                color: #555; /* Soft gray for values */
                font-weight: 400;
                font-size: 0.95em;
                line-height: 1.5;
            }

        /* Button container for right alignment */
        .section-buttons {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 15px;
        }
        
        .main-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-top: 15px;
        }


        /* Button styling */
        .btn {
            width: 90px;
            height: 35px;
            padding: 10px 20px; /* Increased padding for better click area */
            border-radius: 25px; /* Rounded buttons */
            border: none;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 600;
            transition: background-color 0.3s ease;
            display: flex; /* Use flexbox for alignment */
            align-items: center; /* Vertically center text */
            justify-content: center; /* Horizontally center text */
        }

        .btn-main {
            width: 170px;
            height: 45px;
            padding: 10px 20px; /* Increased padding for better click area */
            border-radius: 25px; /* Rounded buttons */
            border: none;
            cursor: pointer;
            font-size: 1.1em;
            font-weight: 700;
            transition: background-color 0.3s ease;
            display: flex; /* Use flexbox for alignment */
            align-items: center; /* Vertically center text */
            justify-content: center; /* Horizontally center text */
        }

        .primary-btn {
            background-color: #3d5b7a; /* Updated button color */
            color: #ffffff;
        }

            .primary-btn:hover {
                background-color: #88badd;
            }

        /* Optional: Hover effect for section */
        .section:hover {
            box-shadow: 0 6px 12px rgba(61, 91, 122, 0.2); /* Use updated color for hover effect */
        }
    </style>

