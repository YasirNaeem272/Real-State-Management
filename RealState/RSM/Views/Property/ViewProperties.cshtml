@model IEnumerable<RSM.BOL.Models.Property>
<div class="form-group">
</div>
<div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
        @*<div class="x_title">
                <h2>Default Example <small>Users</small></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                        <ul class="dropdown-menu" role="menu">
                            <li>
                                <a href="#">Settings 1</a>
                            </li>
                            <li>
                                <a href="#">Settings 2</a>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <a class="close-link"><i class="fa fa-close"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>*@
        <div class="x_content">
            @*<p class="text-muted font-13 m-b-30">
                    DataTables has most features enabled by default, so all you need to do to use it with your own tables is to call the construction function: <code>$().DataTable();</code>
                </p>*@
            <table id="datatable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.PlotNo)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProjectName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Block)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Size)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PropertyType)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model=>model.PropertyStatus)
                        </th>
                        @*<th>
                            @Html.DisplayNameFor(model => model.North)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.East)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.West)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.South)
                        </th>*@
                        <th>Actions</th>
                    </tr>
                </thead>


                <tbody>


                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.PlotNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProjectName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Block)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Size)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PropertyType)
                            </td>
                            @*<td>
                                @Html.DisplayFor(modelItem => item.North)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.East)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.West)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.South)
                            </td>*@

                            <td>

                                <div class="section-buttons">

                                    <button class="btn primary-btn">
                                        <i class="fa fa-edit"> </i> &nbsp;&nbsp;Edit
                                    </button>

                                    <button class="btn primary-btn">
                                        <i class="fa fa-info-circle"> </i> &nbsp;&nbsp;Details
                                    </button>
                                    @{
                                        if (item.PropertyStatus.ToString() == PropertyStatus.Sold.ToString()
                                           || item.PropertyStatus.ToString() == PropertyStatus.Reserved.ToString())
                                        {

                                            <button class="btn btn-success">
                                                <i class="fa fa-print"> </i> &nbsp;&nbsp;Print
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-success">
                                                <i class="fa fa-tags"> </i> &nbsp;&nbsp;Sell
                                            </button>
                                        }
                                    }

                                </div>


                              


                            </td>
                        </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<style>

    body {
        font-family: Arial, sans-serif;
        margin: 20px;
        color: #3d5b7a;
    }

    .summary-container {
        max-width: 800px;
        margin: auto;
        padding: 20px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        color: #3d5b7a;
        margin-bottom: 30px;
        font-size: 1.8em;
        font-weight: 600;
    }


    .section {
        margin-bottom: 20px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background-color: #ffffff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        position: relative;
    }


        .section h3 {
            margin-top: 0;
            color: #3d5b7a;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
            margin-bottom: 15px;
            font-size: 1.2em;
            font-weight: 500;
        }


    .info {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        font-size: 0.95em;
    }

        .info strong {
            color: #3d5b7a;
            font-weight: 600;
        }

        .info span {
            color: #555;
            font-weight: 400;
            font-size: 0.95em;
            line-height: 1.5;
        }


    .section-buttons {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 15px;
    }

    .main-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 15px;
    }



    .btn {
        width: 90px;
        height: 35px;
        padding: 10px 20px;
        border-radius: 25px;
        border: none;
        cursor: pointer;
        font-size: 0.95em;
        font-weight: 600;
        transition: background-color 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-main {
        width: 170px;
        height: 45px;
        padding: 10px 20px;
        border-radius: 25px;
        border: none;
        cursor: pointer;
        font-size: 1.1em;
        font-weight: 700;
        transition: background-color 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .primary-btn {
        background-color: #3d5b7a;
        color: #ffffff;
    }

        .primary-btn:hover {
            background-color: #88badd;
        }


    .section:hover {
        box-shadow: 0 6px 12px rgba(61, 91, 122, 0.2);
    }
</style>