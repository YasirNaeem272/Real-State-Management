@model RSM.BOL.Models.Owner
@{
    int propertyId = ViewData["PropertyID"] != null ? (int)ViewData["PropertyID"] : 0;
}
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<!-- Then include Bootstrap if needed -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<!-- Finally, include your custom script -->
<script src="path/to/your/custom-script.js"></script>
<div class="col-md-4 col-sm-4 col-xs-12 profile_details">
    <div class="well profile_view">
        <div class="col-sm-12">
            <h4 class="brief"><i>@Model.OwnerType</i></h4>
            <div class="left col-xs-7">
                <h2>@Model.FirstName @Model.LastName</h2>
                <p><strong>About: </strong> Web Designer / UI. </p>
                <p>PropertyCount:@Model.PropertyCount</p>
                <ul class="list-unstyled">
                    <li><i class="fa fa-credit-card-alt"></i>  CNIC: @Model.CNIC</li>
                    <li><i class="fa fa-phone"></i>  Phone #: @Model.CellNo </li>

                </ul>
            </div>
            <div class="right col-xs-5 text-center">
                <img src="@Url.Content(Model.ImagePath)" alt="" class="img-circle img-responsive">
            </div>
        </div>
        <a id="showPopupButton" type="button" data-owner-id=@Model.OwnerID>Show Properties</a>
        <!--<button id="showPopupButton" type="button" data-owner-id=@Model.OwnerID>Show Properties</button>--> <!-- Assuming OwnerID is 101 for demonstration -->
        @*<a href="@Url.Action()"></a>*@
        <div class="col-xs-12 bottom text-center">
            <div class="col-xs-12 emphasis">

                @*---ViewNomineesButton---*@
                <button id="showPopupNominee" type="button" data-owner-id=@Model.OwnerID class="btn btn-primary btn-round">
                    <i class="fa fa-users"> </i> Nominees
                </button>
                @*---EditOwnerButton---*@

                <a href=" @Url.Action("EditOwner", "Owner", new { ownerId = Model.OwnerID })"
                   class="btn btn-primary btn-round">
                    <i class="fa fa-edit"> </i> Edit
                </a>

                @*---EditDeleteButton---*@

                <a href=" @Url.Action("Delete", "Owner", new { ownerId = Model.OwnerID })"
                   class="btn btn-danger btn-round">
                    <i class="fa fa-trash"> </i> Delete
                </a>

                @*--SelectButton---*@

                <a href="@Url.Action("GetSelectedOwner", "Owner", new { ownerId = Model.OwnerID})"
                   class="btn btn-success btn-round">
                    Select
                </a>

            </div>
        </div>
    </div>
</div>


<!-- The Popup Modal for properties-->
<div id="myModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close-button">&times;</span>
        <h2>Properties for Owner</h2>
        <div id="propertyList"></div> <!-- This will hold the property data -->
    </div>
</div>
<!-- The Popup Modal for Nominee-->
<div id="nomineeModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close-button">&times;</span>
        <h2>Nominee for Owner</h2>
        <div id="nomineeList"></div> <!-- This will hold the property data -->
    </div>
</div>

<!-- Add some basic styling for the modal for properties-->
<style>
        .modal {
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .modal-content {
            background-color: #fff;
            margin: 15% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 300px;
            text-align: center;
        }

        .close-button {
            float: right;
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>

<!-- JavaScript to handle the popup display and data fetching for properties -->
<script>
   $(document).ready(function () {
    // Attach the click event to all elements with the class 'showPopupButton'
    $(document).on('click', '#showPopupButton', function () {
        // Get the ownerId from the clicked button
        var ownerId = $(this).data("owner-id");

        // You can proceed with your logic, for example, make an AJAX request
        $.ajax({
            url: '@Url.Action("GetPropertiesByOwnerId", "Property")',
            type: 'GET',
            data:{ ownerId: ownerId }, // Pass the ownerId correctly
            success: function (data) {
                var propertyList = $('#propertyList');
                propertyList.empty(); // Clear any existing content

                if (data.length > 0) {
                    data.forEach(function (property) {
                        propertyList.append('<p>PropertyType: ' + property.PropertyType + ', ProjectName: ' + property.ProjectName + '</p>');
                    });
                } else {
                    propertyList.append('<p>No properties found for this owner.</p>');
                }

                // Show the modal after data is loaded
                $('#myModal').show();
            },
            error: function () {
                alert('Failed to load property data.');
            }
        });
    });

    // Close the modal when the close button is clicked
    $('.close-button').on('click', function () {
        $('#myModal').hide();
    });

    // Close the modal when clicking outside of it
    $(window).on('click', function (event) {
        if ($(event.target).is('#myModal')) {
            $('#myModal').hide();
        }
    });
});


    ///

//For Nominee
   $(document).ready(function () {
    // Attach the click event to all elements with the class 'showPopupButton'
       $(document).on('click', '#showPopupNominee', function () {
        // Get the ownerId from the clicked button
        var ownerId = $(this).data("owner-id");

        // You can proceed with your logic, for example, make an AJAX request
        $.ajax({
            url: '@Url.Action("GetNomineesOwnerById", "Nominee")',
            type: 'GET',
            data:{ ownerId: ownerId }, // Pass the ownerId correctly
            success: function (data) {
                var nomineeList = $('#nomineeList');
                nomineeList.empty(); // Clear any existing content

                //if (data.length > 0) {
                //    data.forEach(function (nominee) {
                //        nomineeList.append('<p>Name: ' + nominee.Name + ',CNIC: ' + nominee.CNIC + ', ProjectName: ' + nominee.Relation + '</p>');
                //    });
                //} else {
                //    nomineeList.append('<p>No properties found for this owner.</p>');
                //}
                if (data.length > 0) {
                    // Clear existing content
                    nomineeList.empty();

                    // Create the table structure
                    var table = $('<table border="1" cellspacing="0" cellpadding="5" style="width: 100%; border-collapse: collapse;">');
                    var thead = $('<thead>');
                    var tbody = $('<tbody>');

                    // Append table header
                    thead.append('<tr><th>Name</th><th>CNIC</th><th>Relation</th><th>Image</th></tr>');

                    // Loop through the data and append each row to the table body
                    data.forEach(function (nominee) {
                        var row = $('<tr>');
                        row.append('<td>' + nominee.Name + '</td>');
                        row.append('<td>' + nominee.CNIC + '</td>');
                        row.append('<td>' + nominee.Relation + '</td>');
                        //var imgTag = nominee.ImagePath ? '<img src="' + nominee.ImagePath + '" alt="Nominee Image" style="width: 50px; height: 50px;" />' : 'No Image';
                        var imageUrl = nominee.ImagePath ? nominee.ImagePath.replace('~/', '/') : null;
                        var imgTag = imageUrl ? '<img src="' + imageUrl + '" alt="Nominee Image" style="width: 50px; height: 50px;" />' : 'No Image';
                        row.append('<td>' + imgTag + '</td>');

                        tbody.append(row);
                    });

                    // Append the header and body to the table
                    table.append(thead);
                    table.append(tbody);

                    // Append the table to the nomineeList element
                    nomineeList.append(table);
                } else {
                    // If no data is available, show a message
                    nomineeList.append('<p>No nominees found.</p>');
                }


                // Show the modal after data is loaded
                $('#nomineeModal').show();
            },
            error: function () {
                alert('Failed to load property data.');
            }
        });
    });

    // Close the modal when the close button is clicked
    $('.close-button').on('click', function () {
        $('#nomineeModal').hide();
    });

    // Close the modal when clicking outside of it
    $(window).on('click', function (event) {
        if ($(event.target).is('#nomineeModal')) {
            $('#nomineeModal').hide();
        }
    });
});

</script>




